# انسخ هذا الملف إلى .env وأدخل القيم الخاصة بك
# Copy this file to .env and fill in your own values.

# --- مطلوب (Required) ---
BOT_TOKEN=ضع_توكن_البوت_من_BotFather_هنا
ADMIN_ID=ضع_الرقم_التعريفي_للمدير_هنا

# --- قاعدة البيانات ---
# اترك DATABASE_URL فارغاً => SQLite محلي (database/forexyemeni.db).
# ضع رابط PostgreSQL => المنصة كلها تعمل على قاعدة حقيقية (Supabase/PostgreSQL).
# مثال: postgresql://USER:PASSWORD@HOST:5432/postgres
# لا تشارك الرابط مع أي شخص ولا ترفعه إلى GitHub.
DATABASE_URL=

# --- إعدادات عامة ---
DB_PATH=database/forexyemeni.db
LOG_LEVEL=INFO

# --- مزود بيانات السوق (سلسلة حقيقية بفشل تلقائي متسلسل) ---
# الاختياري الأول: مزود الأسعار المفضل (يُجرب أولاً عند توفره لهذا السوق).
# القيم: BINANCE | BYBIT | YAHOO | GOLD_API | TWELVEDATA — اتركه فارغاً = تلقائي.
# الشموع: BINANCE/BYBIT/TWELVEDATA للكريبتو، YAHOO للفوركس، BINANCE للذهب (PAXG معاير).
# الأسعار اللحظية: GOLD_API (ذهب/فضة)، YAHOO (فوركس)، BINANCE/BYBIT (كريبتو).
# ملاحظة صادقة: GOLD_API لا يوفر شموعاً — يُطبق على الأسعار اللحظية فقط،
# وأي قيمة غير معروفة تُتجاهل بأمان وتبقى السلسلة الافتراضية.
PRICE_PROVIDER=

# مفاتيح اختيارية: TwelveData يفتح كتالوجاً أوسع (حصة مجانية 8 طلبات/دقيقة).
TWELVEDATA_API_KEY=

# روابط بديلة عند حجب جغرافي أو قيود شبكة (اختياري — الافتراضي نقاط النهاية الرسمية):
# BINANCE_BASE_URL=https://api.binance.com
# BYBIT_BASE_URL=https://api.bybit.com

# --- اختياري: نطاق المحرك الافتراضي إذا كانت الكتالوجات فارغة ---
MARKET_SYMBOLS=XAU/USD
MARKET_TIMEFRAME=15min
APP_TIMEFRAME_LABEL=M15
MARKET_SYMBOL_DELAY_SECONDS=6
