# FOREXYEMENI — خدمة systemd للتشغيل الدائم 24/7
# يثبتها deploy/install.sh تلقائياً مع المسارات الصحيحة لحسابك.
[Unit]
Description=FOREXYEMENI Telegram Bot (royal 24/7 service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/forexyemeni-bot
ExecStart=/home/ubuntu/forexyemeni-bot/.venv/bin/python /home/ubuntu/forexyemeni-bot/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
